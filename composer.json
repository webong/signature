{
    "name": "webong/signature",
    "description": "A Laravel identity and authorization foundation for Passport and Sanctum.",
    "keywords": [
        "identity",
        "authorization",
        "oauth",
        "oidc",
        "sso",
        "laravel",
        "passport",
        "sanctum"
    ],
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Signature\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Signature\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Signature\\SignatureServiceProvider"
            ],
            "aliases": {
                "Signature": "Webong\\Signature\\Facades\\Signature"
            }
        }
    },
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "laravel/passport": "Issue OAuth 2.0 access tokens and support third-party clients.",
        "laravel/sanctum": "Authenticate first-party browser sessions and API tokens."
    }
}
